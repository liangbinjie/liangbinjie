<div class="browser-window" id="browser-window" aria-hidden="true">
    <div class="browser-panel">
        <div class="browser-titlebar">
            <span class="browser-title">
                <i class="fa-brands fa-chrome"></i>
                BEN Browser
            </span>
            <button class="browser-close" id="browser-close" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <iframe
            id="browser-frame"
            class="browser-frame"
            title="BEN Browser"
            src="about:blank"
            allow="clipboard-write"
        ></iframe>
    </div>
</div>
