---
import { asset } from '../lib/assets';

const icons = [
    { label: 'My CV', src: asset('static/pdf.png'), id: 'cv-button' },
    { label: 'Projects', src: asset('static/folder.png'), id: 'projects-button' },
    { label: 'Gallery', src: asset('static/gallery.png'), id: 'gallery-button' },
];
---

<div class="desktop">
    {icons.map((icon) => (
        <button class="desktop-button" id={icon.id}>
            <img class="desktop-icon" src={icon.src} alt="" />
            {icon.label}
        </button>
    ))}
</div>
