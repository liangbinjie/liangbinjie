<div class="youtube-window" id="youtube-window" aria-hidden="true">
    <div class="youtube-panel">
        <div class="youtube-titlebar">
            <span class="youtube-title">
                <i class="fa-brands fa-youtube"></i>
                YouTube
            </span>
            <button class="youtube-close" id="youtube-close" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <iframe
            id="youtube-frame"
            class="youtube-frame"
            title="YouTube"
            src="about:blank"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
        ></iframe>
    </div>
</div>
